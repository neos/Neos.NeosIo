prototype(Neos.NeosIo.FeatureList:Molecule.FeatureGroup) < prototype(Neos.Fusion:Component) {

    @styleguide {
        props {
            featureGroupData = Neos.NeosIo.FeatureList:Molecule.FeatureGroup.ExampleData
        }
    }

    featureGroupData = null

    renderer = afx`
        <div class="list-none flex flex-col gap-16 mb-16 md:mb-32 last:mb-0" @if.has={props.featureGroupData} data-component="feature-group">
            <div class="flex flex-col gap-6">
                <div class="flex flex-col gap-2 md:max-w-880px">
                    <div @if.has={props.featureGroupData.icon}>
                        <Neos.Presentation:Icon icon={props.featureGroupData.icon} sizeClass="h-12" class={"text-blue-light"}/>
                    </div>
                    <h2 class="display-headline-sm text-dark-blue">{props.featureGroupData.title}</h2>
                </div>
                <div class="display-body-lg text-neutral-80" @if.has={props.featureGroupData.description}>{props.featureGroupData.description}</div>
            </div>
            <ul class="p-0" @if.hasFeatures={props.featureGroupData.features}>
                <Neos.Fusion:Loop items={props.featureGroupData.features} itemName="feature" @children="itemRenderer" >
                    <Neos.NeosIo.FeatureList:Molecule.Feature featureData={feature} />
                </Neos.Fusion:Loop>
            </ul>
        </div>
    `
}

prototype(Neos.NeosIo.FeatureList:Molecule.FeatureGroup.ExampleData) < prototype(Neos.Fusion:DataStructure) {
    title = 'Feature Group Title'
    description = 'Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua.'
    icon = 'desktop'
    features = Neos.Fusion:DataStructure {
        01 = Neos.NeosIo.FeatureList:Molecule.Feature.ExampleData {
            isCoreFeature = ${true}
            isCommunityFeature = ${false}
        }
        02 = Neos.NeosIo.FeatureList:Molecule.Feature.ExampleData {
            isCoreFeature = ${false}
            isCommunityFeature = ${true}
        }
        03 = Neos.NeosIo.FeatureList:Molecule.Feature.ExampleData {
            isCoreFeature = ${true}
            isCommunityFeature = ${false}
            link = ${null}
        }
    }
}
