prototype(Neos.MarketPlace:VersionMenu) < prototype(Neos.Fusion:Component) {
    title = ${props.title}
    versions = ${props.versions}
    versionCount = ${props.versionCount}
    @context.ctitle = ${this.title}
    @context.cVersions = ${this.versions}
    @context.cVersionCount = ${this.versionCount || 0}

    versionInfo = Neos.Fusion:Case {
        moreThanOne {
            condition = ${cVersionCount > 1}
            renderer = afx`
                <details class="group" @if={cVersionCount > 1}>
                    <summary class="flex gap-4 pointer">
                        <h2 class="display-title-sm font-bold grow-1">{ctitle}</h2>
                        <i class="fas fa-chevron-down text-md transition-transform duration-300 group-open:rotate-180" aria-hidden="true"></i>
                    </summary>
                    <ul class="list-none px-0 pt-4 m-0">
                        <Neos.Fusion:Loop items={Array.slice(cVersions, 1)} itemName="node">
                            <Neos.MarketPlace:VersionMenuItem />
                        </Neos.Fusion:Loop>
                    </ul>
                </details>
            `
        }
        singleVersion {
            condition = ${cVersionCount == 1}
            renderer = afx`
                    <h2 class="display-title-sm font-bold mb-4">{ctitle}</h2>
                    <Neos.MarketPlace:VersionMenuItem @context.node={cVersions[0]} listItem={false}/>
            `
        }

    }

    //@ToDoMine - stability tag?
    renderer = afx`
        <section data-component="Package.VersionMenu">
            {props.versionInfo}
        </section>
    `
}
