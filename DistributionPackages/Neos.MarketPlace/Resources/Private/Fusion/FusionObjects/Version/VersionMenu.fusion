prototype(Neos.MarketPlace:VersionMenu) < prototype(Neos.Fusion:Component) {
    versions = Neos.MarketPlace:VersionsQuery

    //@ToDoMine - stability tag?
    renderer = afx`
        <section class="" data-component="VersionMenu">
            <details class="group" @if={Array.length(props.versions) > 1}>
                <summary class="flex gap-4 pointer">
                    <h2 class="display-title-sm font-bold grow-1">{I18n.translate('versionHistory', 'Version history', [], 'Main', 'Neos.MarketPlace')}</h2>
                    <i class="fas fa-chevron-down text-md transition-transform duration-300 group-open:rotate-180" aria-hidden="true"></i>
                </summary>
                <ul class="list-none px-0 pt-4 m-0">
                    <Neos.Fusion:Loop items={Array.slice(props.versions, 1)} itemName="node">
                        <Neos.MarketPlace:VersionMenuItem />
                    </Neos.Fusion:Loop>
                </ul>
            </details>
        </section>
    `
}
