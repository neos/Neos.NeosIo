// this is based on the abstract Neos.MarketPlace:Version nodetype

prototype(Neos.MarketPlace:AbstractVersion) < prototype(Neos.Fusion:Component) {
    version = ${q(node).property('version')}
    versionNormalized = ${q(node).property('versionNormalized')}
    stability = ${q(node).property('stability')}
    stabilityLevel = ${q(node).property('stabilityLevel')}
    description = ${String.stripTags(q(node).property('description'))}
    keywords = ${q(node).property('keywords')}
    homepage = ${q(node).property('homepage')}
    type = ${q(node).property('type')}
    abandoned = ${q(node).property('abandoned')}
    bin = ${q(node).property('bin')}
    provide = ${q(node).property('provide')}
    require = ${q(node).property('require')}
    requireDev = ${q(node).property('requireDev')}
    suggest = ${q(node).property('suggest')}
    conflict = ${q(node).property('conflict')}
    replace = ${q(node).property('replace')}
    title = ''
    isLatest = false
    latestVersionNumber = ${q(props.latestVersion).property('version')}

    sourceType = ${q(node).property('sourceType')}
    sourceUrl = ${q(node).property('sourceUrl')}

    distReference = ${q(node).property('distReference')}
    distShaSum = ${q(node).property('distShasum')}
    distType = ${q(node).property('distType')}
    distUrl = ${q(node).property('distUrl')}

    hasKeywords = ${String.isBlank(q(node).property('keywords')) ? false : true}
    keywords = Neos.MarketPlace:Tags {
        data = ${q(node).property('keywords')}
    }

    require = Neos.MarketPlace:PackageRequirements {
        property = 'require'
    }
    requireDev = Neos.MarketPlace:PackageRequirements {
        property = 'requireDev'
    }
    suggest = Neos.MarketPlace:PackageRequirements {
        property = 'suggest'
    }
    replace = Neos.MarketPlace:PackageRequirements {
        property = 'replace'
    }
    conflict = Neos.MarketPlace:PackageRequirements {
        property = 'conflict'
    }
    replace = Neos.MarketPlace:PackageRequirements {
        property = 'replace'
    }
    provide = Neos.MarketPlace:PackageRequirements {
        property = 'provide'
    }

    isAbandoned = ${q(documentNode).property('abandoned') ? true : false}
    abandoned = ${q(documentNode).property('abandoned')}
    colClasses = 'w-full md:w-1/2 p-4'
    h2Classes = 'display-title-md mb-2'
    warningClasses = 'bg-yellow-light border-1 border-yellow text-yellow-darkest p-4'

    renderer = afx`
        <div class="version flex flex-col gap-8">
            <Neos.Fusion:Fragment @if={props.abandoned}>
                <p class={props.warningClasses}>{String.replace(I18n.translate('version.abandonedWarning', 'This version is abandoned and no longer maintained. The author suggests using the #package# package instead.', [], 'Main', 'Neos.MarketPlace'), '#package#', '<strong>' + props.abandoned + '</strong>')}</p>
            </Neos.Fusion:Fragment>
            <Neos.Fusion:Fragment @if={!props.abandoned && (props.latestVersionNumber != props.version)}>
                <p class={props.warningClasses}>{String.replace(String.replace(I18n.translate('version.newerVersionAvailable', 'Newer version available: #latestVersion#. You are currently viewing version #currentVersion#.', [], 'Main', 'Neos.MarketPlace'), '#latestVersion#', '<strong>' + props.latestVersionNumber + '</strong>'), '#currentVersion#', '<strong>' + props.version + '</strong>')}</p>
            </Neos.Fusion:Fragment>

            <Neos.Fusion:Fragment @if={props.description}>
                <div>
                  <h2 class={props.h2Classes}>{I18n.translate('Neos.MarketPlace:Main:description')}</h2>
                  <p>{props.description}</p>
                </div>
            </Neos.Fusion:Fragment>

            <div>
                <h2 class="display-title-md mb-4">{I18n.translate('Neos.MarketPlace:Main:installation')}</h2>
                <div class="py-2 px-4 inline-flex bg-neutral-10 self-start gap-2">
                    <i class="fas fa-terminal" aria-hidden="true"></i>
                    <code>
                        composer require {String.stripTags(props.title)}{props.isLatest ? '' : ':'+ props.version}
                    </code>
                </div>
            </div>

            <div class="flex flex-col gap-4">
                <dl class="flex -mx-4 -mb-4 flex-wrap">
                    <Neos.Fusion:Fragment @if={props.homepage}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.homepage', 'Homepage', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.homepage}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                    <Neos.Fusion:Fragment @if={props.type}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.type', 'Type', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.type}</dd>
                        </div>
                    </Neos.Fusion:Fragment>

                    <Neos.Fusion:Fragment @if={props.distUrl}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.distribution', 'Distribution', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>
                                <a href={props.distUrl} title={I18n.translate('version.distribution', 'Distribution', [], 'Main', 'Neos.MarketPlace')}
                                   rel="noreferrer noopener">{props.distType}</a>
                            </dd>
                        </div>
                    </Neos.Fusion:Fragment>
                </dl>
                <dl class="flex -mx-4 -mb-4 flex-wrap">
                    <Neos.Fusion:Fragment @if={props.require}>
                        <div class={'w-full p-4'}>
                            <dt class={props.h2Classes}>{I18n.translate('version.requirements', 'Requirements', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.require}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                    <Neos.Fusion:Fragment @if={props.requireDev}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.requirementsDev', 'Requirements (dev)', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.requireDev}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                    <Neos.Fusion:Fragment @if={props.suggest}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.suggest', 'Suggest', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.suggest}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                    <Neos.Fusion:Fragment @if={props.provide}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.provides', 'Provides', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.provide}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                    <Neos.Fusion:Fragment @if={props.conflict}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.conflicts', 'Conflicts', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.conflict}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                    <Neos.Fusion:Fragment @if={props.replace}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.replaces', 'Replaces', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.replace}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                    <Neos.Fusion:Fragment @if={props.bin}>
                        <div class={props.colClasses}>
                            <dt class={props.h2Classes}>{I18n.translate('version.bin', 'Bin', [], 'Main', 'Neos.MarketPlace')}</dt>
                            <dd>{props.bin}</dd>
                        </div>
                    </Neos.Fusion:Fragment>
                </dl>
            </div>
            <div class="flex flex-col gap-4">
                <div @if.hasKeywords={props.hasKeywords} class="flex gap-2">
                  {props.keywords}
                </div>
            </div>
        </div>
    `
}
