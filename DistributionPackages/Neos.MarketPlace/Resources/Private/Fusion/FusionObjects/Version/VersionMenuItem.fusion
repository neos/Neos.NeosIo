prototype(Neos.MarketPlace:VersionMenuItem) < prototype(Neos.Fusion:Component) {
    version = ${q(node).property('version')}
    time = ${q(node).property('time')}
    versionLink = Neos.Neos:NodeUri {
        node = ${documentNode}
        arguments {
            version = ${q(node).property('version')}
        }
    }
    listItem = true

    renderer = afx`
          <span class="flex gap-4 place-content-between">
            <a href={props.versionLink}>
              {props.version}
            </a>
            <span @if={props.time}>
              {Date.format(props.time, 'd M Y')}
            </span>
          </span>
    `
    @process.wrap = afx`<li>{value}</li>`
    @process.wrap.@if.listItem = ${props.listItem}
}
