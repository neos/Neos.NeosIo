prototype(Neos.MarketPlace:PackageCountButton) < prototype(Neos.Fusion:Component) {
    vendor = null
    @context.vendor = ${this.vendor}

    packageCount = ${q(this.vendor).find('[instanceof Neos.MarketPlace:Package]').count()}
    translation = ${I18n.translate('vendorPackages', '', [], 'Main', 'Neos.MarketPlace')}

    content = ${this.packageCount > 1 ? String.replace(this.translation, '#number#', this.packageCount) : null}

    url = Neos.Neos:NodeUri {
        node = ${vendor}
    }

    renderer = afx`
        <section class="block" @if={props.packageCount > 1}>
            <Neos.Presentation:Button
                href={props.url}
                content={props.content}
                variant={"transparent"}
                icon={"animatedArrow"}
                class={''}
            />
        </section>
    `

    @cache {
        mode = 'cached'

        entryIdentifier {
            vendor = ${Neos.Caching.entryIdentifierForNode(vendor)}
        }

        entryTags {
            vendorNode = ${Neos.Caching.nodeTag(vendor)}
        }
    }
}
