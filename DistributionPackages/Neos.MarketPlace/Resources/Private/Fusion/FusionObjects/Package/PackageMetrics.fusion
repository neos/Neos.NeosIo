prototype(Neos.MarketPlace:PackageMetrics) < prototype(Neos.Fusion:Component) {
    favers = ${q(node).property('favers')}
    downloads = ${q(node).property('downloadTotal')}
    downloadsOnly = false
    faversOnly = false

    renderer = afx`
        <p class=" flex flex-wrap gap-4">
            <span class="flex gap-2 items-center" @if={props.favers && !props.downloadsOnly}>
                <i class="fas fa-star" aria-hidden="true"></i> <span>{props.favers}</span> <span class="sr-only"> {I18n.translate('favers', 'favored', [], 'Main', 'Neos.MarketPlace')}</span>
            </span>
            <span aria-hidden="true" @if.hasBoth={props.favers && props.downloads}>•</span>
            <span class="flex gap-2 items-center" @if={props.downloads && !props.faversOnly}>
                <i class="fas fa-download" aria-hidden="true"></i> <span>{props.downloads}</span> <span class="sr-only"> {I18n.translate('downloads', 'downloads', [], 'Main', 'Neos.MarketPlace')}</span>
            </span>
        </p>
    `
    @if.notEmpty = ${this.favers  || this.downloads}
}
