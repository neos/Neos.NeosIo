prototype(Neos.MarketPlace:PackageRequirementsItem) < prototype(Neos.Fusion:Component) {
    package = ${package}
    version = ${version}

    renderer = afx`
    <tr class="border-b-1 border-neutral-20">
        <td class="px-2 py-1">{props.package}</td>
        <td class="px-2 py-1">{props.version}</td>
    </tr>
    `
}
