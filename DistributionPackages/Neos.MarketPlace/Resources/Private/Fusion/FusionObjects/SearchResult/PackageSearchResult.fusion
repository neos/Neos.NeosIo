prototype(Neos.MarketPlace:PackageSearchResult) < prototype(Neos.MarketPlace:DocumentSearchResult) {
    lastVersion = ${q(node).property('lastVersion')}
    lastVersionLabel = ${q(this.lastVersion).property('version')}
    lastVersionTime = ${q(this.lastVersion).property('time')}
    description = ${String.isBlank(q(this.lastVersion).property('description')) ? q(node).property('description') : q(this.lastVersion).property('description')}
    favers = ${q(node).property('favers')}

    renderer >
    renderer = afx`

        <article class="py-6 border-b-1 border-neutral-20 flex flex-col gap-2">
            <header>
                <h4 class="display-title-md flex gap-4 items-end">
                    <Neos.Neos:NodeLink node={props.node}>
                      {String.stripTags(props.title)}
                    </Neos.Neos:NodeLink>
                </h4>
            </header>
            <div class="flex flex-col gap-2" @if.hasDescriptionOrTags={props.description || q(props.lastVersion).property('keywords')}>
                <p @if.hasDescription={props.description}>
                    {String.stripTags(props.description)}
                </p>
                <Neos.MarketPlace:Tags
                    data={q(props.lastVersion).property('keywords')}
                    @if.hasKeywords={q(props.lastVersion).property('keywords')}
                />
            </div>
            <footer class="flex flex gap-2 flex-col justify-items-start display-body-md text-neutral-50">
                <div class="flex flex-wrap gap-x-4 gap-y-2">
                    <p @if.hasVersion={props.lastVersionLabel}>{props.lastVersionLabel}</p>
                    <span aria-hidden="true" @if.hasVersion={props.lastVersionLabel} class="last-child:hidden">•</span>
                    <Neos.MarketPlace:PackageLastActivity />
                    <span aria-hidden="true" @if.hasLastActivity={q(node).property('lastActivity')} class="last-child:hidden">•</span>
                    <Neos.MarketPlace:PackageMetrics />
                </div>
            </footer>
        </article>
    `
}
