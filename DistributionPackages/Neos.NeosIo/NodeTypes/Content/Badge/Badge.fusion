prototype(Neos.NeosIo:Component.Badge) < prototype(Neos.Fusion:Component) {
    image = ''
    highlight = false
    description = ''
    link = ''
    linkText = ''
    openInNewTab = false

    @propTypes {
        @strict = true
        image = ${PropTypes.string}
        highlight = ${PropTypes.boolean}
        description = ${PropTypes.string}
        link = ${PropTypes.string}
        linkText = ${PropTypes.string}
        openInNewTab = ${PropTypes.boolean}
    }

    @private {
        inBackend = ${renderingMode.isEdit}
        class = Neos.Fusion:DataStructure {
            main = 'px-2 lg:px-4'
            //badge is currently square, so item width = imgHeight + item padding * 2
            width = ${props.highlight ? 'max-w-34 md:max-w-44 lg:max-w-58' : 'max-w-38 lg:max-w-50'}
        }
        imgClass = Neos.Fusion:DataStructure {
            general = ${'h-30 md:h-40 lg:h-50 flex justify-center'}
            pt = ${props.highlight ? '' : 'pt-4 lg:pt-6'}
        }
    }

    renderer = afx`
        <div class={private.class} data-component={'Badge'} >
            <div class={private.imgClass}>
                {props.image}
                <img
                    @if={private.inBackend && !props.image}
                    src={StaticResource.uri('Neos.Neos', 'Public/Images/dummy-image.svg')}
                    title="Dummy image"
                    alt="Dummy image"
                />
            </div>

            <p @if.set={!String.isBlank(props.description)} class="my-2 display-body-sm text-center">
                {props.description}
            </p>

            <Neos.Presentation:Button
                href={props.link}
                content={props.linkText}
                openInNewTab={props.openInNewTab}
                class="whitespace-normal!"
                variant="transparent"
                fullWidth
            />
        </div>

    `
}
