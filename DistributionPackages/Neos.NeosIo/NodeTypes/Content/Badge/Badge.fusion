prototype(Neos.NeosIo:Component.Badge) < prototype(Neos.Fusion:Component) {
    image = ''
    highlight = false
    description = ''
    link = ''
    linkText = ''
    openInNewTab = false

    @propTypes {
        @strict = true
        image = ${PropTypes.string}
        highlight = ${PropTypes.boolean}
        description = ${PropTypes.string}
        link = ${PropTypes.string}
        linkText = ${PropTypes.string}
        openInNewTab = ${PropTypes.boolean}
    }

    @private {
        inBackend = ${renderingMode.isEdit}
        class = Neos.Fusion:DataStructure {
            main = 'flex-1 basis-35 '
            maxWidth = ${props.highlight ? 'max-w-[calc(--spacing(46.5)*1.15)] min-w-[calc(--spacing(32)*1.15)]' : 'max-w-46.5 min-w-32'}
        }
    }

    renderer = afx`
        <div class={private.class} data-component={'Badge'} >
            {props.image}
            <img
                @if={private.inBackend && !props.image}
                src={StaticResource.uri('Neos.Neos', 'Public/Images/dummy-image.svg')}
                title="Dummy image"
                alt="Dummy image"
            />

            <div @if.set={!String.isBlank(props.description)} class="my-2 text-[90%] text-center">
                {props.description}
            </div>

            <Neos.Presentation:Button
                href={props.link}
                content={props.linkText}
                openInNewTab={props.openInNewTab}
                class="whitespace-normal!"
                variant="transparent"
                fullWidth
            />
        </div>

    `
}
