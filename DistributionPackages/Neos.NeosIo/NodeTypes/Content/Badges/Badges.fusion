prototype(Neos.NeosIo:Badges) < prototype(Neos.Neos:ContentComponent) {
    badgeType = ${q(node).property('badgeType')}
    badgeDefinitionPage = ${q(site).property('badgeDefinitionPage')}
    allBadgesOfType = ${this.badgeDefinitionPage ? q(this.badgeDefinitionPage).find('[instanceof Neos.NeosIo:' + this.badgeType + ']').sort('level', 'ASC') :[]}

    renderer = afx`
        <div @if.notEmpty={Array.length(props.allBadgesOfType) > 0} data-component={'Badges'}>
            <div class="flex flex-wrap justify-between items-end gap-7.5 -mx-3.75">
                <Neos.Fusion:Loop items={props.allBadgesOfType} itemName="badge">
                    <Neos.NeosIo:Badge
                        @context.node={badge}
                    />
                </Neos.Fusion:Loop>
            </div>
        </div>
    `
    @cache {
        mode = 'cached'
        entryIdentifier {
            name = 'badges'
            node = ${Neos.Caching.entryIdentifierForNode(node)}
        }
        entryTags {
            documentNode = ${Neos.Caching.nodeTag(documentNode)}
            badges = ${Neos.Caching.nodeTypeTag('Neos.NeosIo:' + badgeType, node)}
        }
    }
}
